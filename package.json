{
  "name": "creative-carnival-registration",
  "version": "1.0.0",
  "private": true,
  "description": "Creative Carnival visitor registration with Express and MySQL",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/app.js",
    "dev": "node --watch server/app.js",
    "db:setup": "node scripts/setup-db.js",
    "admin:password": "node scripts/hash-password.js",
    "admin:setup": "node scripts/hash-password.js --save",
    "test": "node --test test/unit.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.4",
    "validator": "^13.15.35"
  }
}
